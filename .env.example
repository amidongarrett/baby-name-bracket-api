# Server Configuration
NODE_ENV=development
PORT=3001

# Allowed CORS origins (comma-separated)
# Development: include localhost values
# Production example: ALLOWED_ORIGINS=https://babybracket.amidonlabs.com
ALLOWED_ORIGINS=http://localhost:3000

# App URL — used in invitation share links
# Production example: APP_URL=https://babybracket.amidonlabs.com
APP_URL=http://localhost:3000

# Database Configuration
# REQUIRED: MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Authentication — JWT
JWT_SECRET=<random-secret>

# Email — SMTP (leave blank to log OTP codes to stdout in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@babynames.local
